# KSL Hub — Vercel environment variables (คัดลอกไปตั้งใน Vercel Project → Settings → Environment Variables)

# ⚠️ ตั้งให้ครบก่อน deploy — ไม่งั้นหน้าเว็บ/server function ทำงานไม่ครบ

# === Supabase (anon — ใช้ client ฝั่ง browser/SSR) — ค่าเดียวกับ .env บนเครื่อง ===
SUPABASE_URL=https://qzksqhlrkpqnbavjpieq.supabase.co
VITE_SUPABASE_URL=https://qzksqhlrkpqnbavjpieq.supabase.co
SUPABASE_PROJECT_ID=qzksqhlrkpqnbavjpieq
VITE_SUPABASE_PROJECT_ID=qzksqhlrkpqnbavjpieq
SUPABASE_PUBLISHABLE_KEY=<คัดลอกจาก .env เครื่อง — anon key>
VITE_SUPABASE_PUBLISHABLE_KEY=<คัดลอกจาก .env เครื่อง — anon key>

# === Supabase service role (server function /admin เท่านั้น) — ห้ามฝังใน client ===
# เก็บค่าเดียวกับที่อยู่ใน Lovable Cloud deployment env (หรือดูใน Supabase dashboard:
#   qzksqhlrkpqnbavjpieq → Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=<service_role secret — เฉพาะ server-side>

# === Lovable / Google Sheets (เฉพาะฟีเจอร์ /admin sync — ถ้าไม่ใช้เว้นได้) ===
# LOVABLE_API_KEY=<...>
# GOOGLE_SHEETS_API_KEY=<...>

# === Season (SSOT — ตั้งปีที่แสดงหลัก) ===
# ใช้ค่าในโค้ด src/lib/site.ts (SITE_YEAR) ไม่ต้องตั้งใน env เว้นแต่ deploy หน้าเว็บ 2 ฤดูกาล
